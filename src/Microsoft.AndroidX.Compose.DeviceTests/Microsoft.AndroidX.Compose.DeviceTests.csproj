<Project>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Honor per-reference properties during restore as well as build. -->
    <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
    <EnablePreviewFeatures Condition="'$(PublishAot)' == 'true'">true</EnablePreviewFeatures>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>net.compose.devicetests</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- MSTEST0032 fires on Assert.AreEqual(0, (int)ChangedBits.Uncertain)
         etc. because the analyzer can fold constants — but verifying the
         enum's wire-format values match Kotlin's compose-compiler ABI is
         exactly what those tests are for. -->
    <NoWarn>$(NoWarn);MSTEST0032</NoWarn>
    <!--
      Tests cover post-build runtime behaviour we can't assert from source-
      generator unit tests: Modifier.StructuralKey equality, DiffSlot bit
      contributions, RememberAction identity stability, ConfirmStateChange
      JCW veto, carousel default-mask rendering, Offset.Unbox JNI marshalling,
      and Color packing across a bound SolidColor constructor/getter. Run with:

        dotnet build src\Microsoft.AndroidX.Compose.DeviceTests -t:Install
        adb shell am instrument -w net.compose.devicetests/net.compose.devicetests.TestInstrumentation
        Run one test class with:

          adb shell am instrument -w -e filter FullyQualifiedName~CarouselDefaultsTests net.compose.devicetests/net.compose.devicetests.TestInstrumentation
          adb shell am instrument -w -e filter FullyQualifiedName~StateHolderLifecycleTests net.compose.devicetests/net.compose.devicetests.TestInstrumentation
          adb shell am instrument -w -e filter FullyQualifiedName~Collection net.compose.devicetests/net.compose.devicetests.TestInstrumentation
          adb shell am instrument -w -e filter FullyQualifiedName~ScaffoldInsetsTests net.compose.devicetests/net.compose.devicetests.TestInstrumentation

        Scaffold admission controls (2 cases) and full transition/recreation control (1 case):

          adb shell am instrument -w -e filter FullyQualifiedName~ScaffoldInsetsTests.InitialAdmission net.compose.devicetests/net.compose.devicetests.TestInstrumentation
          adb shell am instrument -w -e filter FullyQualifiedName~ScaffoldInsetsTests.TransitionInitialControl net.compose.devicetests/net.compose.devicetests.TestInstrumentation
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" />
    <PackageReference Include="Xamarin.AndroidX.Media3.UI" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProguardConfiguration Include="shared-state-smoke.pro" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AndroidX.Compose.DeviceTests.Resource" Alias="Resource" />
    <Compile Include="..\..\samples\Jetchat\JetchatFonts.cs" Link="Samples\JetchatFonts.cs" />
    <Compile Include="..\..\samples\Jetchat\RecordButton.cs" Link="Samples\RecordButton.cs" />
    <Compile Include="..\..\samples\Jetchat\RecordButtonVisuals.cs" Link="Samples\RecordButtonVisuals.cs" />
    <Compile Include="..\..\samples\Jetchat\RecordingGestureState.cs" Link="Samples\RecordingGestureState.cs" />
    <Compile Include="..\..\samples\Jetchat\Theme\Typography.cs" Link="Samples\Theme\Typography.cs" />
    <Compile Include="..\..\samples\Jetchat\MessageInput.cs" Link="Samples\MessageInput.cs" />
    <Compile Include="..\..\samples\Jetchat\*.cs"
             Exclude="..\..\samples\Jetchat\JetchatFonts.cs;..\..\samples\Jetchat\RecordButton.cs;..\..\samples\Jetchat\RecordButtonVisuals.cs;..\..\samples\Jetchat\RecordingGestureState.cs;..\..\samples\Jetchat\MessageInput.cs"
             Link="Samples\Jetchat\%(Filename)%(Extension)" />
    <Compile Include="..\..\samples\Reply\*.cs"
             Exclude="..\..\samples\Reply\MainActivity.cs"
             Link="Samples\Reply\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <AndroidResource Include="..\..\samples\Jetchat\Resources\drawable\ic_mic.xml" Link="Resources\drawable\ic_mic.xml" />
    <AndroidResource Include="..\..\samples\Jetchat\Resources\drawable\ic_arrow_back.xml" Link="Resources\drawable\ic_arrow_back.xml" />
    <AndroidResource Include="..\Microsoft.AndroidX.Compose.Gallery\Resources\font\*.ttf" Link="Resources\font\%(Filename)%(Extension)" />
    <AndroidResource Include="..\..\samples\Jetchat\Resources\font\montserrat_light.ttf" Link="Resources\font\montserrat_light.ttf" />
    <AndroidResource Include="..\..\samples\Jetchat\Resources\font\montserrat_medium.ttf" Link="Resources\font\montserrat_medium.ttf" />
    <AndroidResource Include="..\..\samples\Jetchat\Resources\font\montserrat_semibold.ttf" Link="Resources\font\montserrat_semibold.ttf" />
    <AndroidResource Include="..\..\samples\Jetchat\Resources\font\karla_*.ttf;..\..\samples\Jetchat\Resources\font\montserrat_regular.ttf"
                     Link="Resources\font\%(Filename)%(Extension)" />
    <AndroidResource Include="..\..\samples\Jetchat\Resources\drawable\*"
                     Exclude="..\..\samples\Jetchat\Resources\drawable\ic_mic.xml;..\..\samples\Jetchat\Resources\drawable\ic_arrow_back.xml;..\..\samples\Jetchat\Resources\drawable\ic_menu.xml;..\..\samples\Jetchat\Resources\drawable\ic_more_vert.xml;..\..\samples\Jetchat\Resources\drawable\ic_search.xml"
                     Link="Resources\drawable\%(Filename)%(Extension)" />
    <AndroidResource Include="..\..\samples\Jetchat\Resources\drawable-nodpi\*"
                     Link="Resources\drawable-nodpi\%(Filename)%(Extension)" />
    <AndroidResource Include="..\..\samples\Jetchat\Resources\drawable-night\*"
                     Link="Resources\drawable-night\%(Filename)%(Extension)" />
    <AndroidResource Include="..\..\samples\Jetchat\Resources\values\strings.xml"
                     Link="Resources\values\jetchat_strings.xml" />
    <AndroidResource Include="..\..\samples\Jetchat\Resources\raw\jetchat_video_fixture.mp4"
                     Link="Resources\raw\jetchat_video_fixture.mp4" />
    <AndroidResource Include="..\..\samples\Reply\Resources\drawable\*"
                     Link="Resources\drawable\%(Filename)%(Extension)" />
    <AndroidResource Include="..\..\samples\Reply\Resources\drawable-nodpi\*"
                     Link="Resources\drawable-nodpi\%(Filename)%(Extension)" />
    <AndroidResource Include="..\..\samples\Reply\Resources\values\strings.xml"
                     Link="Resources\values\reply_strings.xml" />
    <AndroidAsset Include="..\Microsoft.AndroidX.Compose.Gallery\Assets\*LICENSE.txt" Link="Assets\%(Filename)%(Extension)" />
    <AndroidAsset Include="..\Microsoft.AndroidX.Compose.Gallery\Assets\FONT_SOURCES.txt" Link="Assets\FONT_SOURCES.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native publishing is an application setting, not a dependency/analyzer setting. -->
    <ProjectReference Include="..\Microsoft.AndroidX.Compose\Microsoft.AndroidX.Compose.csproj"
                      AdditionalProperties="PublishAot=false" />
    <ProjectReference Include="..\Microsoft.AndroidX.Compose.SourceGenerators\Microsoft.AndroidX.Compose.SourceGenerators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      AdditionalProperties="PublishAot=false" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!-- Restore Android's library output after the desktop test SDK resets it to Exe. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>

</Project>
